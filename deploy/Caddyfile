# Aegis website on the Vultr server. Caddy gets and renews the HTTPS certificate automatically
# once the domain's DNS points at this server. DOMAIN is set in /etc/default/caddy (see setup.sh).
{$DOMAIN}, www.{$DOMAIN} {
	root * /srv/aegis
	encode zstd gzip
	# single-page app: unknown paths serve index.html
	try_files {path} /index.html
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	file_server
}
