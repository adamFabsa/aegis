{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "spacetimedb/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "web/src/module_bindings/**/*.ts",
    "spacetimedb/tests/**/*.ts",
    "data/sim/**/*.ts"
  ]
}
