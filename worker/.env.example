# Copy to worker/.env (gitignored) and fill in.

# Which model the worker uses: gemini (default) or claude. Same calls either way.
AI_PROVIDER=gemini

# Claude (https://platform.claude.com) — used when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high — reply triage and two-sentence notes are short tasks
CLAUDE_EFFORT=low

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Any current Gemini Flash model; default below.
GEMINI_MODEL=gemini-3.6-flash
# Used while the main model is out of daily quota (free tier = 20 requests/day per model). Empty = no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Max Gemini requests in flight at once.
GEMINI_CONCURRENCY=2
# Client-side pacing (requests per minute). Free tier ≈ 5; raise on a paid key.
GEMINI_RPM=5

# SpacetimeDB — same names as the repo's root .env.example / scripts/cli.ts.
# Maincloud (spacetime.maincloud.json). For a local server use http://127.0.0.1:3000.
SPACETIME_SERVER=https://maincloud.spacetimedb.com
SPACETIME_DATABASE=lantern

# Optional: only used by `npm run register` (the module administrator = publishing identity).
# If empty, the register script reads `spacetime login show --token`.
SPACETIME_TOKEN=

# Optional overrides (paths relative to worker/)
# WORKER_TOKEN_FILE=.worker-token
# WORKER_STATE_FILE=.worker-state.json
# SEED_BUILDINGS=../seed/buildings.json
# LOG_LEVEL=info   # debug | info | warn | error
