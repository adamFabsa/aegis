{
  "name": "lantern-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Lantern Gemini worker: classifies resident free-text replies and writes building risk notes into SpacetimeDB.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "register": "node --env-file-if-exists=.env --import tsx src/register.ts",
    "check": "tsc --noEmit",
    "selftest": "node --env-file-if-exists=.env --import tsx src/selftest.ts",
    "e2e": "node --env-file-if-exists=.env --import tsx src/e2e.ts",
    "bindings": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "spacetimedb": "2.14.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
